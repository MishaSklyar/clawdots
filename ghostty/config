# clawdots: black + macOS grays, one orange accent

font-family = JetBrains Mono
font-size = 12

# colors
background = #000000
foreground = #f5f5f7
cursor-color = #da7756
cursor-text = #000000
selection-background = #da7756
selection-foreground = #000000

palette = 0=#1c1c1e
palette = 8=#3a3a3c
palette = 1=#da7756
palette = 9=#e8967a
palette = 2=#8e8e93
palette = 10=#aeaeb2
palette = 3=#c9a27e
palette = 11=#dcc0a2
palette = 4=#98989d
palette = 12=#c7c7cc
palette = 5=#b08a7a
palette = 13=#cdaa9b
palette = 6=#8e8e93
palette = 14=#aeaeb2
palette = 7=#d1d1d6
palette = 15=#f5f5f7

# window: flat, square, never starts maximized/fullscreen
window-decoration = false
gtk-titlebar = false
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0
maximize = false
fullscreen = false
confirm-close-surface = false
app-notifications = false
gtk-single-instance = true

# cursor: solid block
cursor-style = block
cursor-style-blink = false

# behavior
scrollback-limit = 5000000
mouse-hide-while-typing = true
copy-on-select = false
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# keys
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n
